# ============================================================
# 本地 / 部署配置模板
# 使用方法：复制本文件为 application-local.yaml 并填入真实密钥
#   cp src/main/resources/application-local.yaml.example src/main/resources/application-local.yaml
# 注意：application-local.yaml 已被 .gitignore 忽略，不会提交到仓库；
#       本模板文件（.example）随仓库跟踪，便于新环境快速初始化。
# ============================================================

spring:
  # MySQL 数据源（先执行 sql/create.sql 建库建表）
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/fish_ai_code?useUnicode=true&characterEncoding=utf8
    username: root
    password: "你的MySQL密码"

  # Redis（会话 / 缓存 / 分布式锁 / 限流）
  data:
    redis:
      host: localhost
      port: 6379
      ttl: 3600
      database: 0
      # 如果 Redis 设置了密码，取消注释并填写
      # password: "你的Redis密码"

# ------------------------------------------------------------
# AI 模型配置
# 模型统一走 OpenAI 兼容协议（base-url 指向对应服务商）
# ------------------------------------------------------------
langchain4j:
  open-ai:
    # 对话 / 代码生成主模型
    chat-model:
      base-url: https://api.deepseek.com
      api-key: "你的DeepSeek_API_KEY"        # 必填：https://platform.deepseek.com 申请
      model-name: deepseek-chat
      log-requests: true
      log-responses: true
      response-format: json_object
      strict-json-schema: true
      max-retries: 3
    # 流式生成模型（与主模型可同一把 key）
    streaming-chat-model:
      base-url: https://api.deepseek.com
      api-key: "你的DeepSeek_API_KEY"
      model-name: deepseek-chat
      # 重要：必须配置 max-tokens！HTML/MULTI_FILE 代码生成走该模型，
      # 不配置时请求体不带该字段，服务商默认输出上限会把长输出截断
      # （输出顺序 HTML→CSS→JS，截断时 CSS/JS 直接丢失，只剩 index.html）
      max-tokens: 16384
      request-timeout: 120s
      log-requests: true
      log-responses: true
      max-retries: 3
    # 推理模型（Vue 项目工具调用生成）
    reasoning-streaming-chat-model:
      base-url: https://api.deepseek.com
      api-key: "你的DeepSeek_API_KEY"
      model-name: deepseek-reasoner        # 或 deepseek-chat
      request-timeout: 120s
      max-tokens: 32768
      temperature: 0.1
      log-requests: true
      log-responses: true
    # 智能路由模型（判断生成类型，可选阿里云百炼，比 DeepSeek 便宜）
    routing-chat-model:
      base-url: https://api.deepseek.com   # 阿里云百炼: https://dashscope.aliyuncs.com/compatible-mode/v1
      api-key: "你的DeepSeek_API_KEY"
      model-name: deepseek-chat
      log-requests: true
      log-responses: true
    # 图片收集规划模型（短输出任务用轻量模型，避免推理模型耗时+烧 token）
    image-plan-chat-model:
      base-url: https://api.deepseek.com   # 阿里云百炼: https://dashscope.aliyuncs.com/compatible-mode/v1
      api-key: "你的DeepSeek_API_KEY"
      model-name: deepseek-chat
      log-requests: true
      log-responses: true

server:
  # 监听地址：0.0.0.0 允许外部访问；仅本机调试可改 127.0.0.1
  address: 0.0.0.0

# ------------------------------------------------------------
# 可选：图片素材搜索（不配置则 AI 生成时跳过图片收集，不影响核心流程）
# ------------------------------------------------------------
# https://www.pexels.com/ 申请 API key
pexels:
  api-key: "你的Pexels_API_KEY"
# https://undraw.co 申请 token
undraw:
  token: "你的Undraw_TOKEN"

# ------------------------------------------------------------
# 预览静态资源签名 token 密钥（本地开发固定值即可，无公网攻击面）
# 生产部署由 docker-compose 的 PREVIEW_TOKEN_SECRET 注入强随机值
# ------------------------------------------------------------
app:
  # CORS 白名单：必须同时包含主站与预览域（逗号分隔）。
  # 预览 iframe 内的 Vue 静态资源（<script type="module" crossorigin>）是跨域请求，
  # 若预览域不在白名单，Spring 会对带 Origin 的请求返回 403，预览 JS 加载失败、页面只剩 CSS 背景。
  cors-allowed-origins: http://localhost:3000,http://preview.localhost:3000
  preview-token-secret: fish-ai-code-preview-secret-dev
  preview-origin: http://preview.localhost:3000
  preview-frame-ancestor: http://localhost:3000
  # 生成应用默认仅能请求预览域；需要接入 API 时填写精确地址，例如 https://api.example.com
  preview-connect-src: "'self'"
