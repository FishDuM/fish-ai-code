# ============================================================
# Fish AI Code 部署环境变量
# 用法：cp .env.example .env，编辑 .env 填入真实值
#   docker compose up -d --build
# ============================================================

# ── 必填 ──
# DeepSeek API Key（https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=

# ── 数据库（默认值适合快速体验，生产请修改密码）──
DB_PASSWORD=123456
DB_NAME=fish_ai_code

# ── Redis ──
# 如果 Redis 需要密码（生产建议），取消注释
#REDIS_PASSWORD=

# ── AI 模型（可选，默认 DeepSeek）──
#AI_BASE_URL=https://api.deepseek.com
#AI_CHAT_MODEL=deepseek-chat
#AI_REASONING_MODEL=deepseek-reasoner

# ── 图片搜索（可选，不填则跳过图片收集）──
#PEXELS_API_KEY=
#UNDRAW_TOKEN=

# ── Vue 构建镜像（可选，默认 fish-ai-code-vue-builder:20）──
#VUE_BUILDER_IMAGE=fish-ai-code-vue-builder:20

# ── 端口（可选）──
#BACKEND_PORT=8911
#FRONTEND_PORT=80

# ── 部署访问域名（可选，生成的部署链接前缀）──
#APP_DEPLOY_HOST=http://localhost
