# ============================================================
# Fish AI Code 部署环境变量
# 用法：cp .env.example .env，编辑 .env 填入真实值
#   docker compose up -d --build
# ============================================================

# ── 必填 ──
# DeepSeek API Key（https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=

# 预览静态资源签名 token 密钥（必填：强随机值，如 `openssl rand -base64 32`）
# 泄漏此值 = 任何人可伪造预览 token 读取应用源码
PREVIEW_TOKEN_SECRET=
# 预览服务地址及允许嵌入预览页的主站地址。
PREVIEW_ORIGIN=
APP_ORIGIN=
# 生成应用可请求的 API 白名单，默认仅预览域自身；多个地址以空格分隔。
PREVIEW_CONNECT_SRC='self'

# ── 数据库（默认值适合快速体验，生产请修改密码）──
DB_PASSWORD=123456
DB_NAME=fish_ai_code

# ── Redis ──
# 生产建议设置密码；compose 会同时为 Redis 与后端应用该密码。
#REDIS_PASSWORD=

# ── HTTPS 会话 Cookie ──
# 生产 HTTPS 部署时设为 true；本地 HTTP 调试保持 false。
#SESSION_COOKIE_SECURE=true

# ── AI 模型（可选，默认 DeepSeek）──
#AI_BASE_URL=https://api.deepseek.com
#AI_CHAT_MODEL=deepseek-chat
#AI_REASONING_MODEL=deepseek-reasoner
# 单次模型流在未收到响应时的最长等待时间。
#AI_STREAM_REQUEST_TIMEOUT=120s

# ── 图片搜索（可选，不填则跳过图片收集）──
#PEXELS_API_KEY=
#UNDRAW_TOKEN=

# ── Vue 构建镜像（可选，默认 fish-ai-code-vue-builder:20）──
#VUE_BUILDER_IMAGE=fish-ai-code-vue-builder:20
# ── Vue 隔离构建的宿主机代码输出根目录（可选，默认 ${PWD}/data/code_output）──
# 后端容器经 docker.sock 调用宿主机 Docker，--mount 的 bind 源由宿主机 daemon 按
# 宿主机文件系统解析；如数据目录不在 compose 所在目录的 ./data 下，可在此覆盖。
#CODE_OUTPUT_HOST_DIR=/data/fish-ai-code/code_output

# ── 端口（可选）──
#BACKEND_PORT=8911
#FRONTEND_PORT=80

# ── 部署访问域名（可选，生成的部署链接前缀）──
#APP_DEPLOY_HOST=http://localhost
